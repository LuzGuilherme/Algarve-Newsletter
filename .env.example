# Algarve Newsletter - Environment Variables
# Copy this file to .env.local and fill in your actual values

# As inscricoes passam pela API do Algarve Atlas, que guarda a chave do
# MailerLite do lado do servidor. Nao voltar a por a chave aqui: tudo o que
# for VITE_* acaba dentro do bundle publico.
# Deixar vazio usa a producao (https://algarve-hub-api.onrender.com).
VITE_ATLAS_API_URL=

# Gemini API (optional - for AI features)
GEMINI_API_KEY=your_gemini_api_key_here
