# Algarve Newsletter - Environment Variables
# Copy this file to .env.local and fill in your actual values

# MailerLite API Configuration
# Get your API key from: https://dashboard.mailerlite.com/integrations/api
VITE_MAILERLITE_API_KEY=your_mailerlite_api_key_here
VITE_MAILERLITE_GROUP_ID=your_mailerlite_group_id_here

# Gemini API (optional - for AI features)
GEMINI_API_KEY=your_gemini_api_key_here
